PORT=3001

# Banco de dados (Neon — Postgres serverless). Ainda não usado no código: hoje
# tickets, sessões e eventos vivem em memória (server/src/store.ts,
# server/src/auth.ts). Copie a connection string em Neon Dashboard > Connect
# quando a migração pra Postgres acontecer.
DATABASE_URL=

# Secret pra assinar sessão/token. Ainda não usado — auth.ts hoje gera token
# opaco e guarda em memória (Map), o que não sobrevive a múltiplas instâncias
# serverless. Gere um valor com: openssl rand -base64 32
NEXTAUTH_SECRET=
