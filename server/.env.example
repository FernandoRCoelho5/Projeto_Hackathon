PORT=3001

# Banco de dados (Neon — Postgres serverless). Obrigatório: server/src/db.ts
# conecta com isso e cria a tabela `users` automaticamente na primeira query
# (ver migrate() em db.ts). Tickets e eventos de manutenção ainda vivem em
# memória (server/src/store.ts) — só contas de usuário foram migradas.
# Copie a connection string em Neon Dashboard > Connect.
DATABASE_URL=

# Obrigatório: secret pra assinar o token de sessão (HMAC-SHA256, ver
# server/src/auth.ts) — sessão é stateless, sobrevive a múltiplas instâncias
# serverless e cold starts. Gere um valor com: openssl rand -base64 32
NEXTAUTH_SECRET=
